<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.Extensions.Logging" />
    <PackageReference
      Include="MailKit"
      Version="4.16.0"
    />
    <Compile
      Include="../../services/mes-backend/Persistence/Entities/Delivery.cs"
      Link="Actual/Delivery.cs"
    />
    <Compile
      Include="../../services/mes-backend/Persistence/Entities/Notification.cs"
      Link="Actual/Notification.cs"
    />
    <Compile
      Include="../../services/mes-backend/Features/Notifications/LocalDeliveryProvider.cs"
      Link="Actual/LocalDeliveryProvider.cs"
    />
  </ItemGroup>
  <ItemGroup>
    <PackageReference
      Include="FactoryMES.Contracts"
      Version="[1.0.0]"
    />
  </ItemGroup>
</Project>
